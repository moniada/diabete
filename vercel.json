{
    "version": 2,
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/angular",
        "config": {
          "outputDirectory": "dist/mon-projet/browser"
        }
      }
    ],
    "routes": [
      { "src": "/assets/(.*)", "dest": "/assets/$1" },
      { "src": "/(.*)", "dest": "/index.html" }
    ]
  }